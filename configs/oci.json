      "description": "Bucket or resource name",
      "maps_to_flag": "name"
    },
    "region": {
      "description": "Region override",
      "maps_to_flag": "region"
    },
    "profile": {
      "description": "Config profile",
      "maps_to_flag": "profile"
    },
    "output": {
      "description": "json|table|text",
      "maps_to_flag": "output"
    },
    "limit": {
      "type": "integer",
      "description": "Max items per page",
      "maps_to_flag": "limit"
    },
    "page": {
      "description": "Pagination token",
      "maps_to_flag": "page"
    },
    "all": {
      "type": "boolean",
      "description": "Fetch all pages",
      "maps_to_flag": "all"
