  "operations": [
    {
      "id": "region_list",
      "path": "/iam/region/list",
      "method": "post",
      "summary": "List OCI regions",
      "description": "Runs `oci iam region list`. Uses ~/.oci/config for auth (DEFAULT profile, ap-sydney-1 on this host).",
      "argv": ["iam", "region", "list"],
      "fixed_flags": { "output": "json" },
      "include_flags": ["profile", "region", "auth", "query"],
      "include_body_params": ["profile", "region", "query"]
    },
    {
      "id": "compartment_list",
      "path": "/iam/compartment/list",
      "method": "post",
      "summary": "List compartments",
      "description": "Runs `oci iam compartment list`. Pass compartment_id (often tenancy OCID) and optionally compartment-id-in-subtree.",
      "argv": ["iam", "compartment", "list"],
      "fixed_flags": { "output": "json" },
      "include_flags": [
        "compartment-id", "compartment-id-in-subtree", "access-level",
        "all", "limit", "page", "profile", "region", "auth", "query"
      ],
      "include_body_params": [
        "compartment_id", "all", "limit", "page", "profile", "region", "query"
      ]
    },
    {
      "id": "instance_list",
      "path": "/compute/instance/list",
      "method": "post",
      "summary": "List compute instances",
      "description": "Runs `oci compute instance list`. Requires compartment_id. Prefer all=true or a JMESPath query for readable fields.",
      "argv": ["compute", "instance", "list"],
      "fixed_flags": { "output": "json" },
      "include_flags": [
        "compartment-id", "display-name", "lifecycle-state", "availability-domain",
        "all", "limit", "page", "profile", "region", "auth", "query"
      ],
      "include_body_params": [
        "compartment_id", "display_name", "lifecycle_state", "availability_domain",
        "all", "limit", "page", "profile", "region", "query"
      ]
    },
    {
      "id": "instance_get",
      "path": "/compute/instance/get",
      "method": "post",
      "summary": "Get compute instance",
