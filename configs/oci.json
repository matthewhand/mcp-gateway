    "query": {
      "description": "JMESPath --query expression",
      "maps_to_flag": "query"
    },
    "scope": {
      "description": "REGION or AVAILABILITY_DOMAIN (public-ip list)",
      "maps_to_flag": "scope"
    },
    "text": {
      "description": "Free-text search string for resource search",
      "required": true,
      "cli_flag": "text"
    },
