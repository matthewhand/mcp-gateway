  "title": "Oracle Cloud Infrastructure CLI",
  "version": "3.89.1",
  "parse_help": false,
  "timeout_sec": 180,
  "reject_unknown_params": true,
  "sandbox_outputs": false,
  "whitelist": [
    "compartment-id",
    "instance-id",
    "vcn-id",
    "nsg-id",
    "subnet-id",
    "network-firewall-id",
    "network-firewall-policy-id",
    "autonomous-database-id",
    "db-system-id",
    "namespace-name",
    "name",
    "region",
    "profile",
    "output",
    "limit",
    "page",
    "all",
    "display-name",
    "lifecycle-state",
    "availability-domain",
    "query",
    "auth",
    "compartment-id-in-subtree",
    "access-level",
    "scope"
  ],
  "overrides": {
    "compartment-id": {
      "description": "Compartment OCID (tenancy OCID works for root). Required for most list/get calls."
    },
    "instance-id": {
      "description": "Compute instance OCID"
    },
    "vcn-id": {
      "description": "VCN OCID (filter for subnets, NSGs, etc.)"
    },
    "nsg-id": {
      "description": "Network Security Group OCID"
    },
    "subnet-id": {
      "description": "Subnet OCID"
    },
    "network-firewall-id": {
      "description": "OCI Network Firewall OCID"
    },
    "network-firewall-policy-id": {
      "description": "Network Firewall policy OCID"
    },
    "autonomous-database-id": {
      "description": "Autonomous Database OCID"
    },
    "db-system-id": {
      "description": "DB system OCID (Bare Metal / VM / Exadata)"
    },
    "namespace-name": {
      "description": "Object Storage namespace"
    },
    "name": {
      "description": "Bucket or resource name"
    },
    "region": {
      "description": "Region override (default from ~/.oci/config, e.g. ap-sydney-1)"
    },
    "profile": {
      "description": "OCI config profile (default DEFAULT)"
    },
    "output": {
      "enum": ["json", "table", "text"],
      "description": "CLI output format"
    },
    "limit": {
      "type": "integer",
      "description": "Max results per page"
    },
    "page": {
      "description": "Pagination token"
    },
    "all": {
      "type": "boolean",
      "description": "Fetch all pages"
    },
    "display-name": {
      "description": "Filter by display name"
    },
    "lifecycle-state": {
      "description": "Filter by lifecycle state (e.g. RUNNING, AVAILABLE, TERMINATED)"
    },
    "availability-domain": {
      "description": "Availability domain name"
    },
    "query": {
      "description": "JMESPath query to filter/reshape output (oci --query)"
    },
    "auth": {
      "enum": ["api_key", "instance_principal", "resource_principal", "security_token", "instance_obo_user"],
      "description": "Auth type override"
    },
    "compartment-id-in-subtree": {
      "type": "boolean",
      "description": "Include subcompartments when listing"
    },
    "access-level": {
      "enum": ["ANY", "ACCESSIBLE"],
      "description": "Compartment list access level"
    },
    "scope": {
      "enum": ["REGION", "AVAILABILITY_DOMAIN"],
      "description": "Scope for public-ip list (REGION or AVAILABILITY_DOMAIN)"
    }
  },
  "body_params": {
    "compartment_id": {
      "description": "Compartment OCID (maps to --compartment-id). Tenancy OCID is valid for root.",
      "maps_to_flag": "compartment-id"
    },
    "instance_id": {
      "description": "Instance OCID",
      "maps_to_flag": "instance-id"
    },
    "vcn_id": {
      "description": "VCN OCID",
      "maps_to_flag": "vcn-id"
    },
    "nsg_id": {
      "description": "Network Security Group OCID",
      "maps_to_flag": "nsg-id"
    },
