# mcp-gateway — local site configuration (NOT secret, but NOT portable)
#
# Copy to `.env.local` (gitignored) and edit for your host. Anything host- or
# account-specific belongs here rather than in tracked code, so the repository
# can be published verbatim without leaking your hostname, account, or paths.
#
# Secrets (API keys/tokens) go in `.env` instead — also gitignored. This file is
# only for non-secret values that would otherwise be hardcoded in scripts,
# docs, or unit files.
#
# Every value below is OPTIONAL: code falls back to a sensible default when a
# variable is unset, so a fresh clone runs without this file.

# Public HTTPS base URL clients use (OAuth issuer + status page links).
# Default: https://mcp.example.com
MCP_PUBLIC_URL=https://mcp.example.com

# Optional OAuth issuer if it differs from MCP_PUBLIC_URL (e.g. a dedicated
# glama-bridge host). Default: $MCP_PUBLIC_URL
# MCP_OAUTH_ISSUER=https://glama-bridge.example.com

# Hostname shown in docs/README. Default: the host from MCP_PUBLIC_URL.
# MCP_PUBLIC_HOSTNAME=example.com

# Absolute path to the repo checkout on this host. Used by docs, the status
# script, and unit-file examples that print paths. Default: autodetected.
# MCP_ROOT=/home/you/mcp-gateway

# Tailscale / site-to-site network range this gateway serves (informational;
# used only in comments and docs). Default: 100.64.0.0/10
# MCP_SITE_NET=100.64.0.0/10